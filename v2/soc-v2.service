[Unit]
Description=SOC V2 Multi-Agent Pipeline (Orchestrator)
After=network.target suricata.service
Wants=suricata.service

[Service]
Type=simple
User=youruser
WorkingDirectory=/home/youruser/.hermes/soc
EnvironmentFile=/home/youruser/.hermes/soc/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /home/youruser/.hermes/soc/orchestrator_v2.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=soc-v2

[Install]
WantedBy=multi-user.target
